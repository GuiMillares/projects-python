# ── Python ──────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── Node ────────────────────────────────────────────────────
node_modules/
dist/
.vite/
npm-debug.log*

# ── Segredos e ambiente ─────────────────────────────────────
# .env.example fica versionado; o .env real com o token da brapi, não.
.env
.env.local
.env.*.local

# ── Banco local ─────────────────────────────────────────────
# financas.db é o SQLite antigo, com lançamentos reais. O MySQL do
# Laragon vive fora do repositório de qualquer forma; quem recria a
# estrutura é db/schema.sql.
*.db
*.sqlite3
# Backups (ops/backup.py) já recusam pasta dentro do repositório; isto é
# a segunda trava, caso alguém copie um para cá na mão.
*.sql.gpg
*.frase

# ── Sistema e editor ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
